// Custom styles.

.header {  background:;}

// 子标题
.site-subtitle{ font-size: 15px; color: white; }


// 菜单图表链接 以及 超链接样式颜色
a {
    color: rgba(0,0,0,0.8);
}
a:hover {
    color: #1C86EE;
    border-bottom-color: #1C86EE;
}


// 文章背景框框
.post {
    margin-top: 10px;
    margin-bottom: 40px;
    padding: 18px;
    -webkit-box-shadow: 0 0 5px rgba(202, 203, 203, 0.8);
   }

// 站点描述
.site-description {
    font-size: 16px;

}

// 头部inner
.header-inner {
    padding: 45px 0 25px;
    width: 700px;
}

// 作者名
.site-author-name {
    font-family: 'Comic Sans MS', sans-serif;
    font-size: 20px;
}

// 文章之间的分割线
.posts-expand .post-eof {
    margin: 40px auto 40px;
    background: white;
}

// 按钮样式
.btn {
    margin-top: 20px;
}

// ===== 代码样式（GitHub 风格：修正刺眼橙色 + 代码块干净边框）=====
// 行内代码：浅灰底 + 深色字，不再用 #ff7600 橙色
code {
  color: #24292f;
  background: rgba(175, 184, 193, 0.2);
  padding: 0.2em 0.4em;
  border-radius: 4px;
  font-size: 0.88em;
}
// 大代码块（``` 围栏 / 缩进代码）：干净边框 + 浅灰底
.highlight,
pre {
  margin: 20px 0;
  padding: 14px 16px;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  background: #f6f8fa;
  overflow: auto;
  font-size: 13px;
  line-height: 1.6;
}
// 代码块内的 code 还原（继承语法高亮配色，去掉行内 code 的样式/边框）
.highlight code,
pre code {
  padding: 0;
  color: inherit;
  background: none;
  border: none;
  font-size: 13px;
}
// 代码注释/引号：柔和灰，保持清晰
.highlight .comment,
.highlight .quote {
  color: #6e7781;
}

// 文章标题动态效果


// 文章内标题样式（左边的竖线）


body {
    color: #444;
    font-size: 16px;
}

// ===== GitHub 风格表格（覆盖 NexT 5.1.4 默认朴素样式）=====
.post-body table {
  display: block;              // 表格可横向滚动，替代缺失的响应式 wrapper
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-collapse: collapse;
  table-layout: auto;          // 取消默认 fixed 强制均分，列宽自适应内容
  word-wrap: normal;           // 取消强制断词
  font-size: 14px;
  margin: 20px 0;
}
.post-body th,
.post-body td {
  padding: 6px 13px;
  border: 1px solid #d0d7de;
}
.post-body tr {
  background-color: #ffffff;
  border-top: 1px solid #d0d7de;
}
.post-body tr:nth-child(2n) {
  background-color: #f6f8fa;   // 斑马纹
}
.post-body th {
  font-weight: 600;
}
.post-body tbody tr:hover {
  background-color: #f0f3f6;   // 悬停高亮
}

// ===== 排除：代码块内部行号表格不要套文章表格样式 =====
// NexT 的代码块用 <figure class="highlight"><table> 渲染行号，
// 上面的 .post-body table 规则会误伤它，这里还原回去。
.post-body .highlight table {
  display: table;
  width: auto;
  margin: 0;
  border: none;
  border-collapse: collapse;
  table-layout: auto;
  overflow: visible;
}
.post-body .highlight table tr {
  background: transparent;
  border-top: none;
}
.post-body .highlight table th,
.post-body .highlight table td {
  display: table-cell;
  padding: 0;
  border: none;
  background: transparent;
}
.post-body .highlight table tr:nth-child(2n) {
  background: transparent;
}
.post-body .highlight table tbody tr:hover {
  background: transparent;
}
