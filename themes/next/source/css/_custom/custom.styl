// Custom styles.

.header {  background:;}

// 子标题
.site-subtitle{ font-size: 15px; color: white; }


// 菜单图表链接 以及 超链接样式颜色
a {
    color: rgba(0,0,0,0.8);
}
a:hover {
    color: #1C86EE;
    border-bottom-color: #1C86EE;
}


// 文章背景框框
.post {
    margin-top: 10px;
    margin-bottom: 40px;
    padding: 18px;
    -webkit-box-shadow: 0 0 5px rgba(202, 203, 203, 0.8);
   }

// 站点描述
.site-description {
    font-size: 16px;

}

// 头部inner
.header-inner {
    padding: 45px 0 25px;
    width: 700px;
}

// 作者名
.site-author-name {
    font-family: 'Comic Sans MS', sans-serif;
    font-size: 20px;
}

// 文章之间的分割线
.posts-expand .post-eof {
    margin: 40px auto 40px;
    background: white;
}

// 按钮样式
.btn {
    margin-top: 20px;
}

// ``代码块样式
code {
    color: #ff7600;
    background: #fbf7f8;
    border-radius: 3px;
}

// 大代码块的自定义样式
.highlight, pre {
    margin: 5px 0;
    padding: 5px;
    border-radius: 3px;
}
.highlight, code, pre {
    border: 1px solid #d6d6d6;
}

// 文章标题动态效果


// 文章内标题样式（左边的竖线）


body {
    color: #444;
    font-size: 16px;
}

// ===== GitHub 风格表格（覆盖 NexT 5.1.4 默认朴素样式）=====
.post-body table {
  display: block;              // 表格可横向滚动，替代缺失的响应式 wrapper
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-collapse: collapse;
  table-layout: auto;          // 取消默认 fixed 强制均分，列宽自适应内容
  word-wrap: normal;           // 取消强制断词
  font-size: 14px;
  margin: 20px 0;
}
.post-body th,
.post-body td {
  padding: 6px 13px;
  border: 1px solid #d0d7de;
}
.post-body tr {
  background-color: #ffffff;
  border-top: 1px solid #d0d7de;
}
.post-body tr:nth-child(2n) {
  background-color: #f6f8fa;   // 斑马纹
}
.post-body th {
  font-weight: 600;
}
.post-body tbody tr:hover {
  background-color: #f0f3f6;   // 悬停高亮
}
